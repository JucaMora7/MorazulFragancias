# Copiar a .env en cada pieza y completar. Nunca subir el .env a Git.

# API
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Base de datos (PostgreSQL 16; en esta máquina corre en el puerto 5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=morazul
DB_USER=
DB_PASSWORD=

# Almacenamiento de imágenes (proveedor por definir; AWS S3 u otro)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Panel de administración y landing (Vite)
VITE_API_URL=http://localhost:3000
